<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="#101319">
<Switch android:id="@+id/stream_type_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textColor="#F6F8FB" android:textSize="16sp" android:buttonTint="#6CE0BE" />
<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:stretchColumns="1">
<TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/format_label" android:layout_width="86dp" android:layout_height="48dp" android:gravity="center_vertical" android:text="像素格式" android:textColor="#9FA9B8" android:textSize="13sp" />
<Spinner android:id="@+id/format_spinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="像素格式" />
</TableRow>
<TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/fps_label" android:layout_width="86dp" android:layout_height="48dp" android:gravity="center_vertical" android:text="帧率 fps" android:textColor="#9FA9B8" android:textSize="13sp" />
<Spinner android:id="@+id/fps_spinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="帧率" />
</TableRow>
<TableRow android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/resolution_label" android:layout_width="86dp" android:layout_height="48dp" android:gravity="center_vertical" android:text="分辨率" android:textColor="#9FA9B8" android:textSize="13sp" />
<Spinner android:id="@+id/resolution_spinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="分辨率" />
</TableRow>
</TableLayout>
</LinearLayout>