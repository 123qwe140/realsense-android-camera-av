 function(get_nlohmann_json)
+
+    # Handoff: use bundled upstream v3.12.0 sources without a Git download.
+    set(_bundled_json "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third-party/json")
+    if(EXISTS "${_bundled_json}/CMakeLists.txt")
+        # rsutils retains the upstream include path under CMAKE_BINARY_DIR.
+        file(COPY "${_bundled_json}/include" DESTINATION "${CMAKE_BINARY_DIR}/third-party/json")
+        add_subdirectory("${_bundled_json}" "${CMAKE_BINARY_DIR}/third-party/json/build")
+        return()
+    endif()
 
